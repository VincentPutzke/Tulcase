{
  "name": "vscode-tulcase",
  "displayName": "Tulcase",
  "description": "A native VS Code productivity suite — TODOs, time records, bookmarks, commands, lists, and tags — all inside your editor.",
  "version": "1.3.11",
  "publisher": "codewerk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "productivity",
    "todo",
    "bookmarks",
    "time-tracking",
    "snippets"
  ],
  "activationEvents": [
    "onView:tulcase.todos",
    "onView:tulcase.commands",
    "onView:tulcase.links",
    "onView:tulcase.lists",
    "onView:tulcase.tags",
    "onView:tulcase.records"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Tulcase",
      "properties": {
        "tulcase.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Path to the Tulcase data directory. Leave empty to use the default (~/.tulcase)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tulcase",
          "title": "Tulcase",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "tulcase-panel",
          "title": "Tulcase",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tulcase": [
        {
          "id": "tulcase.todos",
          "name": "TODOs",
          "type": "webview"
        },
        {
          "id": "tulcase.commands",
          "name": "Commands",
          "type": "webview"
        },
        {
          "id": "tulcase.lists",
          "name": "Notes",
          "type": "webview"
        },
        {
          "id": "tulcase.links",
          "name": "Links",
          "type": "webview"
        }
      ],
      "tulcase-panel": [
        {
          "id": "tulcase.tags",
          "name": "Tags",
          "type": "webview"
        },
        {
          "id": "tulcase.records",
          "name": "Records",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tulcase.todo.add",
        "title": "Add Todo",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.todo.quickAdd",
        "title": "Quick Add Todo",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.tag.add",
        "title": "Add Tag",
        "category": "Tulcase",
        "icon": "$(add)"
      },

      {
        "command": "tulcase.command.add",
        "title": "Add Command",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.command.copy",
        "title": "Copy Command",
        "category": "Tulcase",
        "icon": "$(copy)"
      },
      {
        "command": "tulcase.command.insert",
        "title": "Insert Command in Terminal",
        "category": "Tulcase",
        "icon": "$(terminal)"
      },
      {
        "command": "tulcase.link.add",
        "title": "Add Link",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.link.open",
        "title": "Open Link",
        "category": "Tulcase",
        "icon": "$(link-external)"
      },
      {
        "command": "tulcase.link.grab",
        "title": "Grab Link URL",
        "category": "Tulcase",
        "icon": "$(clippy)"
      },
      {
        "command": "tulcase.note.add",
        "title": "Add Note",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.note.open",
        "title": "Open Note",
        "category": "Tulcase",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tulcase.record.add",
        "title": "Log Time",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.record.addOther",
        "title": "Log Time (Another Day)",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.refresh",
        "title": "Refresh All",
        "category": "Tulcase",
        "icon": "$(refresh)"
      },
      {
        "command": "tulcase.db.export",
        "title": "Export Database",
        "category": "Tulcase",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tulcase.db.import",
        "title": "Import Database",
        "category": "Tulcase",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tulcase.db.switch",
        "title": "Switch Database",
        "category": "Tulcase",
        "icon": "$(database)"
      },
      {
        "command": "tulcase.db.update",
        "title": "Update Database",
        "category": "Tulcase",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tulcase.tag.add",
          "when": "view == tulcase.tags",
          "group": "navigation"
        },
        {
          "command": "tulcase.record.add",
          "when": "view == tulcase.records",
          "group": "navigation"
        },
        {
          "command": "tulcase.refresh",
          "when": "view =~ /^tulcase\\./",
          "group": "navigation"
        }
      ],

      "commandPalette": [
        { "command": "tulcase.todo.quickAdd", "when": "false" },
        { "command": "tulcase.note.add", "when": "false" },
        { "command": "tulcase.link.add", "when": "false" },
        { "command": "tulcase.refresh", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "command": "tulcase.todo.quickAdd",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "prepackage": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "sass": "^1.98.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^2.0.0"
  }
}
