{
  "name": "vscode-tulcase",
  "displayName": "Tulcase",
  "description": "A native VS Code productivity suite — TODOs, time records, bookmarks, commands, lists, tags, and GitLab pipelines — all inside your editor.",
  "version": "1.8.1",
  "publisher": "codewerk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "productivity",
    "todo",
    "bookmarks",
    "time-tracking",
    "snippets",
    "gitlab",
    "pipelines",
    "ci"
  ],
  "activationEvents": [
    "onView:tulcase.todos",
    "onView:tulcase.commands",
    "onView:tulcase.links",
    "onView:tulcase.lists",
    "onView:tulcase.tags",
    "onView:tulcase.records",
    "onView:tulcase.sync",
    "onView:tulcase.pipePipelines",
    "onView:tulcase.pipeScopes"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Tulcase",
      "properties": {
        "tulcase.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Path to the Tulcase data directory. Leave empty to use the default (~/.tulcase)."
        },
        "tulcase.sync.repoUrl": {
          "type": "string",
          "default": "",
          "description": "HTTPS URL of the git repository used to sync Tulcase data (e.g. https://github.com/user/tulcase-data.git)."
        },
        "tulcase.sync.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically pull on activation and push after data changes."
        },
        "tulcase.pipe.url": {
          "type": "string",
          "default": "https://gitlab.com",
          "description": "GitLab base URL (e.g. https://gitlab.com or your self-hosted instance). The /api/v4 suffix is stripped automatically."
        },
        "tulcase.pipe.pollIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Seconds between pipeline-list refreshes."
        },
        "tulcase.pipe.logPollIntervalSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Seconds between log refreshes for an open running job."
        },
        "tulcase.pipe.maxConcurrentRequests": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum concurrent GitLab requests during a poll cycle."
        },
        "tulcase.pipe.notifyOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a job whose log you opened finishes. (Followed scopes always notify.)"
        },
        "tulcase.pipe.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the latest pipeline status for the current Git branch in the status bar."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tulcase",
          "title": "Tulcase",
          "icon": "media/icon.svg"
        },
        {
          "id": "tulcase-pipe",
          "title": "Tulcase Pipe",
          "icon": "media/pipe-icon.svg"
        },
        {
          "id": "tulcase-pipe-scopes",
          "title": "Pipe Scopes",
          "icon": "media/pipe-scopes-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "tulcase-panel",
          "title": "Tulcase",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tulcase": [
        {
          "id": "tulcase.todos",
          "name": "TODOs",
          "type": "webview"
        },
        {
          "id": "tulcase.commands",
          "name": "Commands",
          "type": "webview"
        },
        {
          "id": "tulcase.lists",
          "name": "Notes",
          "type": "webview"
        },
        {
          "id": "tulcase.links",
          "name": "Links",
          "type": "webview"
        },
        {
          "id": "tulcase.sync",
          "name": "Git Sync",
          "type": "webview"
        }
      ],
      "tulcase-panel": [
        {
          "id": "tulcase.tags",
          "name": "Tags",
          "type": "webview"
        },
        {
          "id": "tulcase.records",
          "name": "Records",
          "type": "webview"
        }
      ],
      "tulcase-pipe": [
        {
          "id": "tulcase.pipePipelines",
          "name": "Pipelines",
          "type": "webview"
        }
      ],
      "tulcase-pipe-scopes": [
        {
          "id": "tulcase.pipeScopes",
          "name": "Pipe Scopes",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tulcase.todo.add",
        "title": "Add Todo",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.todo.quickAdd",
        "title": "Quick Add Todo",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.tag.add",
        "title": "Add Tag",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.command.add",
        "title": "Add Command",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.command.copy",
        "title": "Copy Command",
        "category": "Tulcase",
        "icon": "$(copy)"
      },
      {
        "command": "tulcase.command.insert",
        "title": "Insert Command in Terminal",
        "category": "Tulcase",
        "icon": "$(terminal)"
      },
      {
        "command": "tulcase.link.add",
        "title": "Add Link",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.link.open",
        "title": "Open Link",
        "category": "Tulcase",
        "icon": "$(link-external)"
      },
      {
        "command": "tulcase.link.grab",
        "title": "Grab Link URL",
        "category": "Tulcase",
        "icon": "$(clippy)"
      },
      {
        "command": "tulcase.note.add",
        "title": "Add Note",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.note.open",
        "title": "Open Note",
        "category": "Tulcase",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tulcase.record.add",
        "title": "Log Time",
        "category": "Tulcase",
        "icon": "$(add)"
      },
      {
        "command": "tulcase.record.addOther",
        "title": "Log Time (Another Day)",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.refresh",
        "title": "Refresh All",
        "category": "Tulcase",
        "icon": "$(refresh)"
      },
      {
        "command": "tulcase.db.export",
        "title": "Export Database",
        "category": "Tulcase",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tulcase.db.import",
        "title": "Import Database",
        "category": "Tulcase",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tulcase.db.switch",
        "title": "Switch Database",
        "category": "Tulcase",
        "icon": "$(database)"
      },
      {
        "command": "tulcase.db.update",
        "title": "Update Database",
        "category": "Tulcase",
        "icon": "$(sync)"
      },
      {
        "command": "tulcase.sync.commit",
        "title": "Sync: Commit",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.sync.push",
        "title": "Sync: Push",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.sync.pull",
        "title": "Sync: Pull",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.sync.fullSync",
        "title": "Sync: Full Sync",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.sync.resetToRemote",
        "title": "Sync: Use Remote (Reset Local)",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.runPipeline",
        "title": "Pipe: Run Pipeline",
        "category": "Tulcase",
        "icon": "$(play)"
      },
      {
        "command": "tulcase.pipe.refresh",
        "title": "Pipe: Refresh Pipelines",
        "category": "Tulcase",
        "icon": "$(refresh)"
      },
      {
        "command": "tulcase.pipe.setToken",
        "title": "Pipe: Set GitLab Token",
        "category": "Tulcase",
        "icon": "$(shield)"
      },
      {
        "command": "tulcase.pipe.clearToken",
        "title": "Pipe: Clear GitLab Token",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.editScopesJson",
        "title": "Pipe: Edit Scopes (JSON)",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.importScopes",
        "title": "Pipe: Import Scopes from Tulcase Pipe Extension",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.saveOpenLog",
        "title": "Pipe: Save Job Log",
        "category": "Tulcase",
        "icon": "$(save-as)"
      },
      {
        "command": "tulcase.pipe.openJobLog",
        "title": "Pipe: Open Job Log",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.openJobInBrowser",
        "title": "Pipe: Open Job in Browser",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.openPipelineInBrowser",
        "title": "Pipe: Open Pipeline in Browser",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.copyJobUrl",
        "title": "Pipe: Copy Job URL",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.copyPipelineUrl",
        "title": "Pipe: Copy Pipeline URL",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.downloadArtifacts",
        "title": "Pipe: Download Artifacts",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.saveJobLog",
        "title": "Pipe: Save Job Log to File",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.retryPipeline",
        "title": "Pipe: Retry Pipeline",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.cancelPipeline",
        "title": "Pipe: Cancel Pipeline",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.retryJob",
        "title": "Pipe: Retry Job",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.cancelJob",
        "title": "Pipe: Cancel Job",
        "category": "Tulcase"
      },
      {
        "command": "tulcase.pipe.playJob",
        "title": "Pipe: Run Manual Job",
        "category": "Tulcase"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tulcase.tag.add",
          "when": "view == tulcase.tags",
          "group": "navigation"
        },
        {
          "command": "tulcase.record.add",
          "when": "view == tulcase.records",
          "group": "navigation"
        },
        {
          "command": "tulcase.pipe.runPipeline",
          "when": "view == tulcase.pipePipelines",
          "group": "navigation@1"
        },
        {
          "command": "tulcase.pipe.refresh",
          "when": "view == tulcase.pipePipelines",
          "group": "navigation@2"
        },
        {
          "command": "tulcase.refresh",
          "when": "view =~ /^tulcase\\./ && view != tulcase.pipePipelines && view != tulcase.pipeScopes",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "tulcase.pipe.saveOpenLog",
          "when": "resourceScheme == tulcase-pipe-log",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tulcase.todo.quickAdd",
          "when": "false"
        },
        {
          "command": "tulcase.note.add",
          "when": "false"
        },
        {
          "command": "tulcase.link.add",
          "when": "false"
        },
        {
          "command": "tulcase.refresh",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.openJobLog",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.openJobInBrowser",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.openPipelineInBrowser",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.copyJobUrl",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.copyPipelineUrl",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.downloadArtifacts",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.saveJobLog",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.retryPipeline",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.cancelPipeline",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.retryJob",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.cancelJob",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.playJob",
          "when": "false"
        },
        {
          "command": "tulcase.pipe.saveOpenLog",
          "when": "resourceScheme == tulcase-pipe-log"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/pipe_db/scopes.json",
        "url": "./schemas/pipe-scopes.schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "tulcase.todo.quickAdd",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      },
      {
        "command": "tulcase.internal.forceCustomValue",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "inQuickOpen"
      }
    ],
    "languageModelTools": [
      {
        "name": "tulcase_list_todos",
        "displayName": "Tulcase: List TODOs",
        "toolReferenceName": "tulcase_list_todos",
        "icon": "$(checklist)",
        "userDescription": "List your Tulcase TODOs with optional filters (all, open, done, overdue, today) and tag filtering.",
        "modelDescription": "List Tulcase TODO items. Supports filtering by status (all/open/done/overdue/today) and by tag name. Returns an array of todo items with id, note, date, done, and tags fields.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "filter": {
              "type": "string",
              "enum": [
                "all",
                "done",
                "open",
                "overdue",
                "today"
              ],
              "description": "Filter todos by status. Default: all."
            },
            "tag": {
              "type": "string",
              "description": "Filter todos to only those with this tag."
            }
          }
        }
      },
      {
        "name": "tulcase_add_todo",
        "displayName": "Tulcase: Add TODO",
        "toolReferenceName": "tulcase_add_todo",
        "icon": "$(add)",
        "userDescription": "Add a new TODO to Tulcase.",
        "modelDescription": "Create a new Tulcase TODO item. Requires a note (text). Optionally set a date (YYYY-MM-DD, defaults to today) and tags (array of tag names).",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string",
              "description": "The TODO text."
            },
            "date": {
              "type": "string",
              "description": "Due date in YYYY-MM-DD format. Defaults to today."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tag names to attach."
            }
          },
          "required": [
            "note"
          ]
        }
      },
      {
        "name": "tulcase_update_todo",
        "displayName": "Tulcase: Update TODO",
        "toolReferenceName": "tulcase_update_todo",
        "icon": "$(edit)",
        "userDescription": "Update an existing Tulcase TODO (mark done, change text, date, or tags).",
        "modelDescription": "Update a Tulcase TODO item by ID. Can change done status, note text, date, or tags. Use tulcase_list_todos first to get valid IDs.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The todo ID."
            },
            "done": {
              "type": "boolean",
              "description": "Mark as done or not done."
            },
            "note": {
              "type": "string",
              "description": "New text for the todo."
            },
            "date": {
              "type": "string",
              "description": "New date in YYYY-MM-DD format."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Replace tags with this list."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "tulcase_delete_todo",
        "displayName": "Tulcase: Delete TODO",
        "toolReferenceName": "tulcase_delete_todo",
        "icon": "$(trash)",
        "userDescription": "Delete a Tulcase TODO by ID.",
        "modelDescription": "Permanently delete a Tulcase TODO item by its ID. Use tulcase_list_todos first to get valid IDs.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The todo ID to delete."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "tulcase_list_notes",
        "displayName": "Tulcase: List Notes",
        "toolReferenceName": "tulcase_list_notes",
        "icon": "$(note)",
        "userDescription": "List all Tulcase notes and folders, with optional tag filtering.",
        "modelDescription": "List all Tulcase notes and their folder structure. Optionally filter by tag. Returns notes (id, label, content, tags, folder, createdAt, updatedAt) and folders (id, name, parent).",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "description": "Filter notes to only those with this tag."
            }
          }
        }
      },
      {
        "name": "tulcase_read_note",
        "displayName": "Tulcase: Read Note",
        "toolReferenceName": "tulcase_read_note",
        "icon": "$(open-preview)",
        "userDescription": "Read the full content of a Tulcase note by ID.",
        "modelDescription": "Read the full content and metadata of a Tulcase note by its ID. Use tulcase_list_notes first to find valid IDs.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The note ID to read."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "tulcase_add_note",
        "displayName": "Tulcase: Add Note",
        "toolReferenceName": "tulcase_add_note",
        "icon": "$(new-file)",
        "userDescription": "Create a new Tulcase note.",
        "modelDescription": "Create a new Tulcase note. Requires a label. Optionally set content (markdown text), tags, and folder ID. Use tulcase_list_notes to see available folders.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "The note title."
            },
            "content": {
              "type": "string",
              "description": "The note content (markdown)."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tag names to attach."
            },
            "folder": {
              "type": "string",
              "description": "Folder ID to place the note in. Empty string or omit for root."
            }
          },
          "required": [
            "label"
          ]
        }
      },
      {
        "name": "tulcase_edit_note",
        "displayName": "Tulcase: Edit Note",
        "toolReferenceName": "tulcase_edit_note",
        "icon": "$(edit)",
        "userDescription": "Edit an existing Tulcase note (label, content, tags, or folder).",
        "modelDescription": "Edit a Tulcase note by ID. Can change label, content, tags, or folder. Use tulcase_list_notes first to get valid IDs.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The note ID to edit."
            },
            "label": {
              "type": "string",
              "description": "New title."
            },
            "content": {
              "type": "string",
              "description": "New content (markdown)."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Replace tags with this list."
            },
            "folder": {
              "type": "string",
              "description": "Move to this folder ID."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "tulcase_manage_note_folder",
        "displayName": "Tulcase: Manage Note Folder",
        "toolReferenceName": "tulcase_manage_note_folder",
        "icon": "$(folder)",
        "userDescription": "Create, rename, or delete note folders in Tulcase.",
        "modelDescription": "Manage Tulcase note folders. Action create makes a folder optionally under parentId. Action rename changes a folder name by id. Action delete removes a folder by id and moves its direct child notes and direct subfolders to root.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "create",
                "rename",
                "delete"
              ],
              "description": "Folder operation to perform."
            },
            "id": {
              "type": "string",
              "description": "Existing folder ID. Required for rename and delete."
            },
            "name": {
              "type": "string",
              "description": "Folder name. Required for create and rename."
            },
            "parentId": {
              "type": "string",
              "description": "Parent folder ID for create. Omit or empty for root."
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "tulcase_move_note_entry",
        "displayName": "Tulcase: Move Note Entry",
        "toolReferenceName": "tulcase_move_note_entry",
        "icon": "$(move)",
        "userDescription": "Move a note or note folder into another folder or back to root.",
        "modelDescription": "Move a Tulcase note entry by id. The id may belong to either a note or a folder. targetFolderId selects the destination folder. Omit targetFolderId or use an empty string to move the entry to root.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The note or folder ID to move."
            },
            "targetFolderId": {
              "type": "string",
              "description": "Destination folder ID. Omit or empty for root."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "tulcase_list_links",
        "displayName": "Tulcase: List Links",
        "toolReferenceName": "tulcase_list_links",
        "icon": "$(link)",
